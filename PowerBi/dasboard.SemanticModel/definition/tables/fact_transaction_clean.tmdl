	column 'Txn Date' =
			
			DATE(
			    YEAR(fact_transaction_clean[txn_ts]),
			    MONTH(fact_transaction_clean[txn_ts]),
			    DAY(fact_transaction_clean[txn_ts])
			)
		formatString: General Date
		lineageTag: 293466f8-e63c-4b24-b40b-0c164c50fbbe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Card Age Band' =
			
			SWITCH(
			    TRUE(),
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 30, "0-30 days",
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 90, "31-90 days",
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 180, "91-180 days",
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 365, "181-365 days",
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 730, "1-2 years",
			    "2+ years"
			)
		lineageTag: b2000005-0000-4000-8000-000000000001
		summarizeBy: none
		sortByColumn: 'Card Age Sort'

		annotation SummarizationSetBy = Automatic

	column 'Card Age Sort' =
			
			SWITCH(
			    TRUE(),
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 30, 1,
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 90, 2,
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 180, 3,
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 365, 4,
			    DATEDIFF(RELATED(dim_card[issue_date]), DATE(2025, 1, 1), DAY) <= 730, 5,
			    6
			)
		formatString: 0
		lineageTag: b2000006-0000-4000-8000-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Value-range banding for Page 2.
	/// 
	/// These are calculated columns rather than a band dimension table with
	/// SWITCH measures. The disconnected-table variant was tried first and
	/// fails: SWITCH over a column from an unrelated table needs single-value
	/// row context, which SUMMARIZECOLUMNS does not supply, so every band
	/// measure raised "a single value for column ... cannot be determined".
	/// Columns on the fact table make the visuals plain drag-and-drop.
	/// 
	/// Card age uses the COHORT definition - age as of 2025-01-01 - to match
	/// sql/06_temporal_cohort_analysis.sql and notebook 03. An earlier version
	/// measured age at each transaction instead, which put the 0-30 day band at
	/// 1.01% rather than the validated 0.69%. Both are defensible, but they are
	/// different questions and only one matches the project's own analysis:
	/// cohort   : 54,185 txns (3.62% of volume), 372 fraud, 0.69%
	/// txn-time :  2,227 txns (0.15% of volume),  22 fraud, 1.01%
	/// The txn-time band is too thin to read (22 events; 95% CI 0.65-1.49%
	/// brackets the 0.70% baseline, two-sided p = 0.14), so the cohort
	/// definition is both more consistent and more informative.
	/// 
	/// DATEDIFF is inlined rather than reading a separate 'Card Age Days'
	/// column: a same-table calculated-column dependency once left the
	/// dependents at State=5 with no data while the dependency reported
	/// State=1. Inlining removes the ordering hazard and saves a column.
	column 'Amount Band' =
			
			SWITCH(
			    TRUE(),
			    fact_transaction_clean[amount] <= 500, "0-500",
			    fact_transaction_clean[amount] <= 1000, "500-1K",
			    fact_transaction_clean[amount] <= 5000, "1K-5K",
			    fact_transaction_clean[amount] <= 10000, "5K-10K",
			    fact_transaction_clean[amount] <= 25000, "10K-25K",
			    fact_transaction_clean[amount] <= 50000, "25K-50K",
			    fact_transaction_clean[amount] <= 100000, "50K-100K",
			    "100K+"
			)
		lineageTag: b2000002-0000-4000-8000-000000000001
		summarizeBy: none
		sortByColumn: 'Amount Band Sort'

		annotation SummarizationSetBy = Automatic

	column 'Amount Band Sort' =
			
			SWITCH(
			    TRUE(),
			    fact_transaction_clean[amount] <= 500, 1,
			    fact_transaction_clean[amount] <= 1000, 2,
			    fact_transaction_clean[amount] <= 5000, 3,
			    fact_transaction_clean[amount] <= 10000, 4,
			    fact_transaction_clean[amount] <= 25000, 5,
			    fact_transaction_clean[amount] <= 50000, 6,
			    fact_transaction_clean[amount] <= 100000, 7,
			    8
			)
		formatString: 0
		lineageTag: b2000003-0000-4000-8000-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// ip_country vs merchant_country. The brief's original DAX used
	/// RELATED(dim_customer[country]), but dim_customer has no country column -
	/// it carries home_city. Both fields needed are already on this table.
	column 'Country Match' =
			
			SWITCH(
			    TRUE(),
			    fact_transaction_clean[ip_country] = "UNKNOWN", "Unknown",
			    fact_transaction_clean[ip_country] = fact_transaction_clean[merchant_country], "Match",
			    "Mismatch"
			)
		lineageTag: b2000004-0000-4000-8000-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// The strongest observed combination: 40.24% fraud rate, 69.19% of total
	/// fraud value. The production rule (R001) tightens this to 20K.
	/// 
	/// Labels are deliberately short. An earlier build used
	/// "E-comm + Electronics/Gift Cards + 10K+" and the bar chart failed to
	/// render at all - the category axis had no room for a label that long.
	column 'Risk Pattern' =
			
			SWITCH(
			    TRUE(),
			    fact_transaction_clean[channel] = "E_COMMERCE"
			        && fact_transaction_clean[category] IN { "Electronics", "Gift Cards" }
			        && fact_transaction_clean[amount] >= 10000,
			        "E-comm high-risk 10K+",
			    "All other transactions"
			)
		lineageTag: b2000007-0000-4000-8000-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_transaction_clean = m
		mode: import
		source =
