				  Source = Csv.Document(File.Contents("D:\fraud-loss-analysis-step1\fraud-loss-analysis\data\processed\fact_transaction_clean.csv"), [Delimiter = ",", Columns = 14, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"txn_id", Int64.Type}, {"card_id", Int64.Type}, {"customer_id", Int64.Type}, {"merchant_id", Int64.Type}, {"device_id", Int64.Type}, {"txn_ts", type datetime}, {"amount", type number}, {"channel", type text}, {"category", type text}, {"merchant_city", type text}, {"merchant_country", type text}, {"ip_country", type text}, {"auth_result", type text}, {"customer_home_city", type text}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

